# 复制为 .env 使用；生产环境用容器/密钥管理注入，不要提交 .env
# 优先级：环境变量 / .env > config.ini > 代码默认值

# MySQL（会话历史 / FAQ 标准答案）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=zhiqing
MYSQL_PASSWORD=123456
MYSQL_DATABASE=zhiqing_kb

# Milvus（知识库分块集合 + FAQ 问句集合）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE_NAME=zhiqing
MILVUS_COLLECTION_NAME=zhiqing_kb
MILVUS_FAQ_COLLECTION_NAME=zhiqing_faq
# 嵌入推理设备/精度：auto（有 GPU 就用 cuda+fp16）/ cuda / cpu
EMBEDDING_DEVICE=auto
EMBEDDING_FP16=auto

# 大模型（OpenAI 兼容协议）：换成你自己的 key，占位符会让问答走兜底话术
LLM_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT 鉴权（演示账号，生产务必修改并用环境变量注入）
AUTH_USERNAME=admin
AUTH_PASSWORD=zhiqing@2026
JWT_SECRET=zhiqing-dev-secret-change-in-prod

# 说明：分块大小/检索阈值/知识域列表/客服电话等在 config.ini 配置（settings 只读 ini）。